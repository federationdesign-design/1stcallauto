# Copy to .env.local for local development. Set the same values in Vercel.

# Public site
NEXT_PUBLIC_SITE_URL=https://1st-call.uk
NEXT_PUBLIC_WHATSAPP_NUMBER=447725629835

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (Steve supplies).
# GA only loads after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification value (Steve supplies).
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact and free quote form, delivered by Resend (same method as LHM).
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "1st Call Auto <noreply@1st-call.uk>"
NOTIFICATION_EMAIL_FROM=
# Comma-separated list of addresses that receive form submissions
CONTACT_EMAIL_TO=info@1st-call.uk
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
